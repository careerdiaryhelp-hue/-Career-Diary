{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.careerdiary.in"
        }
      ],
      "destination": "https://careerdiary.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|facebook|twitter|whatsapp|telegram|discord|linkedin|slack).*"
        }
      ],
      "destination": "/api/og?path=$1"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
