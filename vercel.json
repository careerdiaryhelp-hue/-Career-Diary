{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.careerdiary.in"
        }
      ],
      "destination": "https://careerdiary.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/([^/.]+)",
      "destination": "/api/ssr?path=$1"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
