{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.careerdiary.in"
        }
      ],
      "destination": "https://careerdiary.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/([^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB]ot|[fF]acebook|[tT]witter|[wW]hats[aA]pp|[tT]elegram|[dD]iscord|[lL]inked[iI]n|[sS]lack).*"
        }
      ],
      "destination": "/api/og?path=$1"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
