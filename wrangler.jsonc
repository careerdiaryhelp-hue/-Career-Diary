{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-diary",
  "main": "worker/src/index.js",
  "compatibility_date": "2024-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm run build"
  }
}
